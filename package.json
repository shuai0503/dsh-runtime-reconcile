{
  "name": "dsh-runtime-reconcile",
  "version": "0.2.1",
  "description": "A read-only agent tool that reconciles what a DeepSeek Harness profile declares against what is actually registered in the live runtime.",
  "displayName": "Runtime Reconcile",
  "icon": "icon.svg",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "diagnostics",
    "runtime",
    "runtime-reconciliation",
    "plugin-conflict",
    "plugin-diagnostics",
    "observability",
    "profile-health",
    "ssrf-prevention",
    "tool-registry",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuai0503/dsh-runtime-reconcile.git"
  },
  "bugs": {
    "url": "https://github.com/shuai0503/dsh-runtime-reconcile/issues"
  },
  "homepage": "https://github.com/shuai0503/dsh-runtime-reconcile#readme",
  "author": "shuai0503",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "test/selftest.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/selftest.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.4.0-0"
  }
}
